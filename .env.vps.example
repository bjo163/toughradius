# Copy to .env; the VPS installer replaces generated secrets before startup.
TZ=Asia/Jakarta
MWX_ISP_WEB_PORT=1816
# The installer sets these values to match the selected web access mode.
MWX_ISP_DOMAIN=localhost
MWX_ISP_TLS_MODE=http-local
MWX_ISP_CADDY_ADDRESS=http://localhost
MWX_ISP_CADDY_TLS_DIRECTIVE=
MWX_ISP_CADDY_BIND=127.0.0.1
MWX_ISP_WEB_SECRET=CHANGE_ME_generate_a_long_random_secret
MWX_ISP_ADMIN_PASSWORD=CHANGE_ME_use_a_unique_password
POSTGRES_DB=mwxisp
POSTGRES_USER=mwxisp
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
