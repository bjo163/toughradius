# Copy to .env and replace every CHANGE_ME value before starting.
TZ=Asia/Jakarta
MWX_ISP_WEB_PORT=1816
# Set your public domain for automatic HTTPS (e.g. isp.example.com) or leave as localhost
MWX_ISP_DOMAIN=localhost
MWX_ISP_WEB_SECRET=CHANGE_ME_generate_a_long_random_secret
MWX_ISP_ADMIN_PASSWORD=CHANGE_ME_use_a_unique_password
POSTGRES_DB=mwxisp
POSTGRES_USER=mwxisp
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
