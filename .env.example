# MWX-ISP environment configuration
# Copy this file to .env and replace the example credentials.

# ============================================
# System
# ============================================
TOUGHRADIUS_SYSTEM_WORKER_DIR=/var/toughradius
TOUGHRADIUS_SYSTEM_DEBUG=false

# ============================================
# Web service
# ============================================
TOUGHRADIUS_WEB_HOST=0.0.0.0
TOUGHRADIUS_WEB_PORT=1816
# Set to false to disable the built-in HTTPS listener.
TOUGHRADIUS_WEB_TLS_ENABLED=true
TOUGHRADIUS_WEB_TLS_PORT=1817
# Use a unique, long random value for each installation.
TOUGHRADIUS_WEB_SECRET=CHANGE_ME_generate_a_long_random_secret

# Optional control-plane account for creating and suspending ISP tenants.
# Set both values; password must be at least 12 characters. No platform admin
# is created when these values are empty.
MWX_PLATFORM_ADMIN_USERNAME=
MWX_PLATFORM_ADMIN_PASSWORD=

# ============================================
# Database configuration (PostgreSQL is the default.)
# ============================================
TOUGHRADIUS_DB_TYPE=postgres
TOUGHRADIUS_DB_HOST=127.0.0.1
TOUGHRADIUS_DB_PORT=5432
TOUGHRADIUS_DB_NAME=mwxisp
TOUGHRADIUS_DB_USER=mwxisp
TOUGHRADIUS_DB_PWD=CHANGE_ME_use_a_long_database_password

TOUGHRADIUS_DB_DEBUG=false

# ============================================
# RADIUS service
# ============================================
TOUGHRADIUS_RADIUS_ENABLED=true
TOUGHRADIUS_RADIUS_HOST=0.0.0.0
TOUGHRADIUS_RADIUS_AUTHPORT=1812
TOUGHRADIUS_RADIUS_ACCTPORT=1813
TOUGHRADIUS_RADIUS_RADSEC_PORT=2083
TOUGHRADIUS_RADIUS_RADSEC_WORKER=100
TOUGHRADIUS_RADIUS_DEBUG=false

# ============================================
# Logging
# ============================================
TOUGHRADIUS_LOGGER_MODE=development
TOUGHRADIUS_LOGGER_FILE_ENABLE=true
