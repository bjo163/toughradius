# Copy to .env and replace both secrets with generated values.
MWX_CONTROL_MODE=control
MWX_CONTROL_NODE_ID=mwx-control-01
MWX_CONTROL_NODE_NAME=Developer Control
MWX_CONTROL_MWX_ISP_VERSION=control-plane

# All trusted nodes use the same 32-byte base64 key. Generate once with:
# openssl rand -base64 32
MWX_CONTROL_GOSSIP_KEY=

# The first/control node needs no peers. Agent nodes list one or more existing
# peers, for example: 203.0.113.10:7946
MWX_CONTROL_PEERS=
MWX_CONTROL_GOSSIP_ADDR=0.0.0.0
MWX_CONTROL_GOSSIP_PORT=7946
MWX_CONTROL_ADVERTISE_ADDR=203.0.113.10
MWX_CONTROL_ADVERTISE_PORT=7946
MWX_CONTROL_BIND_HOST=0.0.0.0
MWX_CONTROL_ALLOWED_CIDRS=

# Owner API is published on 127.0.0.1:8080 only. Generate with:
# openssl rand -hex 32
MWX_CONTROL_ADMIN_TOKEN=
MWX_CONTROL_HTTP_ADDR=0.0.0.0:8080

# Optional HTTP(S) health URL on this instance; use the MWX-ISP admin URL.
MWX_CONTROL_HEALTH_URL=
